#!/usr/bin/env bash
# Orbit on one server: install, update and operate a self-hosted instance.
#
#   deploy/orbit install     first run: checks the server, generates secrets, builds, starts, migrates
#   deploy/orbit update      after `git pull`: rebuilds, migrates, restarts what changed
#   deploy/orbit status      every service and its health, the URL, the last backup
#   deploy/orbit help        everything else
#
# The only file a person edits is deploy/.env (copied from deploy/.env.example). Everything this
# script generates is appended to the same file, so backing up that one file backs up every secret.
# Full guide: docs/SELF_HOSTING.md.
set -euo pipefail

ORBIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPLOY_DIR="$ORBIT_ROOT/deploy"
ENV_FILE="${ORBIT_ENV_FILE:-$DEPLOY_DIR/.env}"
ORBIT_ENV_FILE="$ENV_FILE"
UPSTREAM_DIR="$DEPLOY_DIR/.upstream"
export ORBIT_ROOT ORBIT_ENV_FILE

# shellcheck source=deploy/lib/common.sh
source "$DEPLOY_DIR/lib/common.sh"
# shellcheck source=deploy/lib/secrets.sh
source "$DEPLOY_DIR/lib/secrets.sh"
# shellcheck source=deploy/lib/backup.sh
source "$DEPLOY_DIR/lib/backup.sh"
# shellcheck source=deploy/lib/import.sh
source "$DEPLOY_DIR/lib/import.sh"

# --- Configuration --------------------------------------------------------------------------------

load_env() {
  [[ -f "$ENV_FILE" ]] || die "No $ENV_FILE yet. Run: cp deploy/.env.example deploy/.env, fill it in (docs/SELF_HOSTING.md), then run this again."
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a

  ORBIT_DATA_DIR="${ORBIT_DATA_DIR:-/var/lib/orbit}"
  if [[ "${ORBIT_HTTP_ONLY:-false}" == "true" ]]; then
    ORBIT_PUBLIC_URL="http://${ORBIT_DOMAIN}"
    ORBIT_SITE_ADDRESS="http://${ORBIT_DOMAIN}"
  else
    ORBIT_PUBLIC_URL="https://${ORBIT_DOMAIN}"
    ORBIT_SITE_ADDRESS="${ORBIT_DOMAIN}"
  fi
  # The names the upstream Supabase stack reads, all derived from the one domain.
  SITE_URL="$ORBIT_PUBLIC_URL"
  SUPABASE_PUBLIC_URL="$ORBIT_PUBLIC_URL"
  API_EXTERNAL_URL="$ORBIT_PUBLIC_URL/auth/v1"
  # orbit:// and exp:// are where the iOS client's Google sign-in returns (mobile/, through Expo Go
  # for exp://). Both sign in with PKCE, so a code sent to another app on those schemes cannot be
  # exchanged without the verifier the requesting app kept.
  ADDITIONAL_REDIRECT_URLS="$ORBIT_PUBLIC_URL/**,orbit://**,exp://**"
  ORBIT_VERSION="$(git -C "$ORBIT_ROOT" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
  # The app switches MCP on only for the exact value "1" (src/lib/mcp/config.ts).
  case "${MCP_SERVER_ENABLED:-false}" in
    1 | true | TRUE | True | yes) MCP_SERVER_ENABLED=1 ;;
    *) MCP_SERVER_ENABLED=0 ;;
  esac
  export ORBIT_DATA_DIR MCP_SERVER_ENABLED ORBIT_PUBLIC_URL ORBIT_SITE_ADDRESS SITE_URL SUPABASE_PUBLIC_URL \
    API_EXTERNAL_URL ADDITIONAL_REDIRECT_URLS ORBIT_VERSION
}

# Fails with one line per problem, so a person (or an agent) can fix them all in one pass.
check_env() {
  local problems=0 name
  for name in ORBIT_DOMAIN ORBIT_ADMIN_EMAIL ORBIT_ALLOWED_EMAILS GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET; do
    if [[ -z "${!name:-}" || "${!name}" == *"CHANGE_ME"* ]]; then
      err "deploy/.env: $name is not filled in (see the comment above it)"
      problems=$((problems + 1))
    fi
  done
  if [[ -n "${ORBIT_DOMAIN:-}" && ! "$ORBIT_DOMAIN" =~ ^[A-Za-z0-9.-]+$ ]]; then
    err "deploy/.env: ORBIT_DOMAIN must be a bare domain like orbit.example.com (no https://, no slash)"
    problems=$((problems + 1))
  fi
  [[ -n "${OPENROUTER_API_KEY:-}" ]] || warn "OPENROUTER_API_KEY is empty: document recognition and money categorization will be off"
  ((problems == 0)) || die "Fix the $problems line(s) above in deploy/.env and run the command again."
}

# --- Docker compose -------------------------------------------------------------------------------

compose() {
  # ORBIT_COMPOSE_EXTRA: colon-separated extra override files, for local changes kept out of git.
  local extra=() files=() file
  IFS=: read -r -a files <<<"${ORBIT_COMPOSE_EXTRA:-}"
  for file in "${files[@]}"; do [[ -n "$file" ]] && extra+=(-f "$file"); done
  docker compose \
    --project-name orbit \
    --project-directory "$UPSTREAM_DIR/docker" \
    -f "$UPSTREAM_DIR/docker/docker-compose.yml" \
    -f "$DEPLOY_DIR/docker-compose.yml" \
    "${extra[@]}" \
    --env-file "$DEPLOY_DIR/supabase.defaults.env" \
    --env-file "$ENV_FILE" \
    "$@"
}

# Fetches Supabase's docker/ directory at the pinned commit. Idempotent: does nothing when the
# checkout is already at that commit.
fetch_upstream() {
  # shellcheck source=deploy/supabase-upstream.env
  source "$DEPLOY_DIR/supabase-upstream.env"
  if [[ -d "$UPSTREAM_DIR/.git" ]] &&
    [[ "$(git -C "$UPSTREAM_DIR" rev-parse HEAD 2>/dev/null)" == "$SUPABASE_UPSTREAM_COMMIT" ]]; then
    return
  fi
  step "Fetching self-hosted Supabase $SUPABASE_UPSTREAM_TAG"
  rm -rf "$UPSTREAM_DIR"
  git init -q "$UPSTREAM_DIR"
  git -C "$UPSTREAM_DIR" remote add origin https://github.com/supabase/supabase.git
  git -C "$UPSTREAM_DIR" sparse-checkout set --no-cone /docker
  retry 4 git -C "$UPSTREAM_DIR" fetch -q --depth 1 --filter=blob:none origin "$SUPABASE_UPSTREAM_COMMIT"
  git -C "$UPSTREAM_DIR" checkout -q FETCH_HEAD
}

# What deploy/functions.Dockerfile builds from, written into the empty or missing directory OUT:
# Orbit's functions, upstream's router (`main`, which dispatches /functions/v1/<name> to ./<name>)
# and an import map, all in functions/; the types they share in db/; the base image's name in
# edge-runtime-image. The map carries only `imports` from supabase/functions/deno.json -- the
# runtime does not read lockfile v5, the same reason scripts/just/deploy-supabase.cjs moves
# deno.lock aside for the hosted deploy.
assemble_functions() {
  local out="${1:?Usage: deploy/orbit assemble-functions <dir>}"
  fetch_upstream
  mkdir -p "$out/functions" "$out/db"
  cp -R "$ORBIT_ROOT/supabase/functions/." "$out/functions/"
  rm -f "$out/functions/deno.lock" "$out/functions/deno.json"
  find "$out/functions" -name '*_test.ts' -delete
  rm -rf "$out/functions/main" && cp -R "$UPSTREAM_DIR/docker/volumes/functions/main" "$out/functions/main"
  sed -n '/"imports"/,/}/p' "$ORBIT_ROOT/supabase/functions/deno.json" |
    { echo "{"; cat; echo "}"; } >"$out/functions/deno.jsonc"
  # _shared/database.types.ts re-exports ../../db/database.types.ts, i.e. supabase/db.
  cp "$ORBIT_ROOT/supabase/db/database.types.ts" "$out/db/database.types.ts"
  cp "$DEPLOY_DIR/functions.Dockerfile" "$out/Dockerfile"
  cp "$DEPLOY_DIR/functions-warm.sh" "$out/warm.sh"
  # The runtime upstream pins for this release, so the functions run on what upstream tested.
  grep -m1 -oE 'supabase/edge-runtime:[^[:space:]"]+' "$UPSTREAM_DIR/docker/docker-compose.yml" \
    >"$out/edge-runtime-image" || die "No edge runtime image in upstream's docker-compose.yml"
  chmod -R a+rX "$out"
}

# CI's image for this commit when there is one; built here otherwise, which downloads the
# functions' modules from deno.land, npm and jsr.io once, at build time.
ensure_functions_image() {
  pull_prebuilt functions && return
  local dir
  dir="$(mktemp -d)"
  assemble_functions "$dir"
  docker build --build-arg EDGE_RUNTIME_IMAGE="$(cat "$dir/edge-runtime-image")" \
    -t orbit-functions:local "$dir" || { rm -rf "$dir"; die "Could not build the edge functions' image (above)"; }
  rm -rf "$dir"
}

prepare_data_dir() {
  mkdir -p "$ORBIT_DATA_DIR"/{db,storage,caddy,wal-spool,backup-state}
  # The database (uid 100 in supabase/postgres) writes the WAL spool; the backup container empties it.
  chown 100:101 "$ORBIT_DATA_DIR/wal-spool" 2>/dev/null || chmod 777 "$ORBIT_DATA_DIR/wal-spool"
}

wait_healthy() {
  local deadline=$((SECONDS + ${1:-300})) unhealthy=""
  step "Waiting for every service to report healthy"
  while ((SECONDS < deadline)); do
    # `|`-separated: a service without a healthcheck (caddy) has an empty Health field.
    unhealthy="$(compose ps --format '{{.Service}}|{{.Health}}|{{.State}}' |
      awk -F'|' '$3 != "running" || ($2 != "" && $2 != "healthy") {print $1}')"
    [[ -z "$unhealthy" ]] && return 0
    sleep 3
  done
  compose ps
  # The cause, where a deploy from GitHub can show it: what the failing healthcheck printed. Not the
  # service's own log, which can hold user data and would land in a public Actions log; that goes
  # to a file on the server instead.
  local service container logfile
  logfile="$ORBIT_DATA_DIR/unhealthy-$(date -u +%Y%m%dT%H%M%SZ).log"
  (umask 077 && : >"$logfile")
  for service in $unhealthy; do
    container="$(compose ps -q "$service" 2>/dev/null | head -1)"
    printf '\n%s: its last healthcheck said: %s\n' "$service" "$(docker inspect --format '{{json .State.Health}}' \
      "$container" 2>/dev/null | jq -r '.Log[-1].Output // empty' 2>/dev/null | tr -s '\n' ' ' | cut -c1-300)"
    compose logs --no-color --tail 200 "$service" >>"$logfile" 2>&1 || true
    # From the log, only the hosts of the addresses its errors name: no paths, no queries.
    printf '%s: its errors name: %s\n' "$service" "$(compose logs --no-color --tail 200 "$service" 2>&1 |
      grep -iE 'error|fail' | grep -oE 'https?://[A-Za-z0-9.-]+' | sort -u | tr '\n' ' ' || true)"
  done
  die "Still not healthy after ${1:-300}s: $(echo "$unhealthy" | tr '\n' ' '). Their logs are in $logfile on the server"
}

# What the server, and Orbit's containers, can reach. Orbit needs both: the server pulls images, and
# its containers call out -- Auth to Google for sign-in, the functions to OpenRouter for AI.
# deno.land, npm and JSR matter only to a server that builds the functions' image itself. Only
# reports: a failure further on then has its cause named here. Probes from a one-off backup
# container on Orbit's own network, the path the services take; a host counts as reachable only
# when it answers as it should (2xx or 3xx, not a block page) and the whole answer arrives -- some
# networks let a connection open and then stall it. A failure shows curl's reason: a timeout where
# the server itself gets through usually means packets too large for the server's link
# (deploy/bootstrap.sh, clamp_container_mss).
check_network() {
  local urls=(https://api.github.com https://accounts.google.com/.well-known/openid-configuration
    https://deno.land https://registry.npmjs.org https://jsr.io/@std/path/meta.json https://openrouter.ai/api/v1/models)
  local url host i from_server from_container dev server_blocked=() container_blocked=() container_codes
  dev="$(ip -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' || true)"
  step "Checking what this server and its containers can reach (link MTU $(cat "/sys/class/net/${dev:-none}/mtu" 2>/dev/null || echo '?'))"
  # The loop runs in the container: its variables are meant for that shell, not this one.
  # shellcheck disable=SC2016
  container_codes="$(compose run --rm --no-deps -T --entrypoint sh backup -c \
    'for u in "$@"; do curl -s -o /dev/null -m 10 -w "%{http_code} %{exitcode}\n" "$u" || true; done' sh "${urls[@]}" 2>/dev/null || true)"
  i=0
  for url in "${urls[@]}"; do
    i=$((i + 1))
    from_server="$(curl -s -o /dev/null -m 10 -w '%{http_code} %{exitcode}' "$url" || true)"
    from_container="$(sed -n "${i}p" <<<"$container_codes")"
    printf '     %-62s server %-20s containers %s\n' "$url" "$(curl_result "${from_server:-000 0}")" "$(curl_result "${from_container:-000 0}")"
    host="${url#https://}"
    host="${host%%/*}"
    if ! reached "$from_server"; then
      server_blocked+=("$host")
    elif ! reached "$from_container"; then
      container_blocked+=("$host")
    fi
  done
  ((${#server_blocked[@]} == 0)) ||
    warn "This server cannot reach: ${server_blocked[*]}. Its network or the service refuses it; whatever needs those will not work from here."
  ((${#container_blocked[@]} == 0)) ||
    warn "Orbit's containers cannot reach: ${container_blocked[*]}, although this server can."
  ((${#server_blocked[@]} + ${#container_blocked[@]})) || ok "the server and Orbit's containers reach the internet"
}

# Whether "<http code> <curl exit code>" is a whole answer of the expected kind.
reached() { [[ "${1%% *}" =~ ^[23][0-9][0-9]$ && "${1##* }" == 0 ]]; }

# "<http code> <curl exit code>" as a person reads it: the code, or why there was none.
curl_result() {
  local code="${1%% *}" exit="${1##* }"
  case "$code:$exit" in
    000:28) echo "timed out" ;;
    000:6) echo "no DNS" ;;
    000:7) echo "refused" ;;
    000:35) echo "TLS failed" ;;
    000:*) echo "failed ($exit)" ;;
    *:0) echo "$code" ;;
    *:28) echo "$code, then stalled" ;;
    *) echo "$code, then failed ($exit)" ;;
  esac
}

# --- Commands -------------------------------------------------------------------------------------

cmd_check() {
  load_env
  preflight_server
  check_env
  ok "deploy/.env is complete"
}

cmd_install() {
  step "Checking the server"
  preflight_server
  load_env
  check_env
  configure_registry_mirror
  ensure_swap
  step "Generating missing secrets into deploy/.env"
  ensure_secrets "$ENV_FILE"
  load_env
  fetch_upstream
  prepare_data_dir
  cmd_build
  check_network
  start_migrated
  smoke_test
  prune_images
  ensure_backups_on
  summary
}

# Writes the NAME=value lines of a settings file into deploy/.env: what CI and bootstrap.sh hand
# over. Each value is taken literally up to the end of its line; deploy/.env is created from
# .env.example first if there is none, and lines the file does not mention are left alone.
cmd_apply_env() {
  local from="${1:?Usage: deploy/orbit apply-env <file>}" line name value current count=0
  [[ -f "$from" ]] || die "$from does not exist"
  [[ -f "$ENV_FILE" ]] || install -m 600 "$DEPLOY_DIR/.env.example" "$ENV_FILE"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[A-Z][A-Z0-9_]*= ]] || continue
    name="${line%%=*}"
    value="${line#*=}"
    current="$(grep -E "^$name=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true)"
    # An empty value clears an optional setting, but never a key the server created for itself.
    if [[ -z "$value" && -n "$current" ]] && grep -qx "$name" <<<"$GENERATED_NAMES"; then continue; fi
    # Every key of an installed server came from its master key; another one would not open them.
    if [[ "$name" == ORBIT_MASTER_KEY && -n "$current" && "$value" != "$current" ]] &&
      env_has POSTGRES_PASSWORD "$ENV_FILE"; then
      die "$from has a different ORBIT_MASTER_KEY than this server was installed with; this server's is in $ENV_FILE"
    fi
    env_set "$ENV_FILE" "$name" "$value"
    count=$((count + 1))
  done <"$from"
  chmod 600 "$ENV_FILE"
  ok "wrote $count setting(s) into $ENV_FILE"
}

cmd_update() {
  load_env
  check_env
  ensure_swap
  ensure_secrets "$ENV_FILE"
  load_env
  fetch_upstream
  prepare_data_dir
  cmd_build
  check_network
  start_migrated
  smoke_test
  prune_images
  ensure_backups_on
  ok "Orbit updated to $ORBIT_VERSION"
}

# The schema moves before the code that needs it is exposed: `migrate` starts only what it depends
# on (db, storage), and the web app and functions are (re)created afterwards. If the migration
# fails, the previous release keeps serving against the schema it knows.
start_migrated() {
  cmd_migrate
  step "Starting the stack"
  compose up -d --remove-orphans
  wait_healthy 600
  # Where releases before the functions image kept their code, mounted into the container `up` has
  # just replaced; the image carries it now.
  rm -rf "$ORBIT_DATA_DIR/functions" "$ORBIT_DATA_DIR/functions-db"
  warm_functions
}

# A function's first request after a restart builds its module graph, which takes seconds; the
# runtime then keeps the worker and its compiled modules. Paying that here means the first cron
# tick or user request after an update gets a warm function. Each function answers a bare OPTIONS
# with an empty 200 and does nothing else, so this is safe to repeat. It must not look like a CORS
# preflight (no Origin, no Access-Control-Request-Method): the gateway answers those itself and the
# worker would never see the request. Straight at the gateway's loopback port, which works the same
# with and without HTTPS.
warm_functions() {
  local dir name code cold=()
  step "Warming up the edge functions"
  for dir in "$ORBIT_ROOT"/supabase/functions/*/; do
    name="$(basename "$dir")"
    [[ "$name" == _* ]] && continue
    code="$(curl -s -o /dev/null -m 60 -w '%{http_code}' -X OPTIONS -H "apikey: $ANON_KEY" \
      "http://127.0.0.1:8000/functions/v1/$name" || true)"
    [[ "$code" == 200 ]] || cold+=("$name (HTTP $code)")
  done
  if ((${#cold[@]} == 0)); then
    ok "edge functions are warm"
  else
    warn "not warmed, so their first request will be slow or fail: ${cold[*]}. Look at: deploy/orbit logs functions"
  fi
}

# The images CI publishes for each commit on main (publish-self-hosted-images in
# .github/workflows/main.yml). The same commit means the same code, so a fork's server can use them
# for every commit it shares with this repository and builds the rest itself.
ORBIT_PREBUILT_IMAGES_DEFAULT=ghcr.io/mpodreshetnikov/orbit

# Pulls the prebuilt image for the checked-out commit under the local name compose runs, and fails
# when there is none to pull: an uncommitted change, a commit CI has not published (yet), or a
# processor it does not build for.
pull_prebuilt() {
  local kind="$1" prefix="${ORBIT_PREBUILT_IMAGES:-$ORBIT_PREBUILT_IMAGES_DEFAULT}" sha image
  [[ "${ORBIT_BUILD_LOCALLY:-false}" != "true" ]] || return 1
  sha="$(git -C "$ORBIT_ROOT" rev-parse HEAD 2>/dev/null)" || return 1
  # Any change, a new untracked file included, means the code is not that commit's. Ignored files
  # (deploy/.env, deploy/.upstream) are not code and do not count.
  [[ -z "$(git -C "$ORBIT_ROOT" status --porcelain 2>/dev/null)" ]] || return 1
  image="$prefix-$kind:$sha"
  # A commit's image never changes, so one already here is used as is: a rollback to the version
  # prune_images kept works even when the registry does not answer.
  docker image inspect "$image" >/dev/null 2>&1 || docker pull --quiet "$image" >/dev/null 2>&1 || return 1
  docker tag "$image" "orbit-$kind:local"
}

# Every deploy pulls four images for its commit, and nothing removed them: a few commits a day
# filled the disk (T-261026-tja). After a deploy that answers, this keeps the images of the running
# commit and of the one deployed before it -- what a rollback needs -- and removes the prebuilt
# images of every other commit, then the untagged layers that earlier `orbit-*:local` tags and local
# builds left behind. Volumes, data and images a container still uses are never touched. The
# previous commit is the last line of deployed-commits; before that file exists, the newest image
# of another commit stands in for it. Nothing here fails the deploy: Orbit is up by now.
prune_images() {
  local prefix="${ORBIT_PREBUILT_IMAGES:-$ORBIT_PREBUILT_IMAGES_DEFAULT}" sha previous history kind ref
  local root before after removed=0
  sha="$(git -C "$ORBIT_ROOT" rev-parse HEAD 2>/dev/null)" || return 0
  history="$ORBIT_DATA_DIR/deployed-commits"
  previous="$(grep -v -x -F "$sha" "$history" 2>/dev/null | tail -1 || true)"
  if [[ -z "$previous" ]]; then
    previous="$(docker images --format '{{.CreatedAt}}\t{{.Tag}}' "$prefix-web" 2>/dev/null |
      sort -r | cut -f2 | grep -v -x -F "$sha" | grep -E '^[0-9a-f]{40}$' | head -1 || true)"
  fi
  if [[ "$(tail -1 "$history" 2>/dev/null)" != "$sha" ]]; then
    { [[ -z "$previous" ]] || echo "$previous"; echo "$sha"; } >"$history.tmp" && mv "$history.tmp" "$history" ||
      warn "Could not record the deployed commit in $history"
  fi
  step "Removing images of older versions (keeping ${sha:0:12}${previous:+ and ${previous:0:12}})"
  root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
  before="$(df -Pk "${root:-/}" 2>/dev/null | awk 'NR==2 {print int($4 / 1048576)}' || true)"
  for kind in web tools functions backup; do
    while read -r ref; do
      [[ -n "$ref" ]] || continue
      case "${ref##*:}" in "$sha" | "$previous") continue ;; esac
      docker rmi "$ref" >/dev/null 2>&1 && removed=$((removed + 1))
    done < <(docker images --format '{{.Repository}}:{{.Tag}}' "$prefix-$kind" 2>/dev/null)
  done
  docker image prune --force >/dev/null 2>&1 || true
  after="$(df -Pk "${root:-/}" 2>/dev/null | awk 'NR==2 {print int($4 / 1048576)}' || true)"
  ok "removed $removed image(s); free on disk: ${before:-?} GB before, ${after:-?} GB now"
}

# Every command that runs the backup image gets it here: CI's image for this commit when there is
# one, built on this server only otherwise -- a build needs Ubuntu's and PostgreSQL's package
# archives, which a server's network may not reach.
ensure_backup_image() {
  pull_prebuilt backup && return
  compose build backup
}

cmd_build() {
  load_env
  step "Getting the web app"
  if pull_prebuilt web && pull_prebuilt tools; then
    ok "pulled the images CI built for this commit"
  else
    if [[ "${ORBIT_BUILD_LOCALLY:-false}" == "true" ]]; then
      step "Building it here (a few minutes on the first run)"
    else
      step "No prebuilt images for this commit; building them here (a few minutes on the first run)"
    fi
    compose build web
    compose --profile tools build migrate
  fi
  step "Getting the edge functions"
  ensure_functions_image
  ok "the edge functions are ready, every module they import included"
  ensure_backup_image
}

cmd_migrate() {
  load_env
  step "Migrating the database"
  compose --profile tools run --rm migrate
}

smoke_test() {
  local base="http://127.0.0.1" host_header="Host: $ORBIT_DOMAIN" code
  step "Checking the instance answers"
  # Straight at Caddy over plain HTTP with the right Host header, so it works before DNS points
  # here. With HTTPS on, Caddy answers port 80 with a redirect, which still proves the domain routes.
  code="$(curl -s -o /dev/null -w '%{http_code}' -H "$host_header" -H "apikey: $ANON_KEY" "$base/auth/v1/health" || true)"
  [[ "$code" =~ ^(200|301|308)$ ]] || die "Auth did not answer through Caddy (HTTP $code). deploy/orbit logs caddy api-gw auth"
  code="$(curl -s -o /dev/null -w '%{http_code}' -H "$host_header" -H "apikey: $SERVICE_ROLE_KEY" \
    -H "Authorization: Bearer $SERVICE_ROLE_KEY" "$base/rest/v1/" || true)"
  [[ "$code" =~ ^(200|301|308)$ ]] || die "The database API did not answer through Caddy (HTTP $code). deploy/orbit logs rest"
  code="$(curl -s -o /dev/null -w '%{http_code}' -H "$host_header" "$base/login" || true)"
  [[ "$code" =~ ^(200|301|307|308)$ ]] || die "The web app did not answer through Caddy (HTTP $code). deploy/orbit logs web"
  ok "Caddy routes the domain to Auth, the database API and the web app"
}

# Backups switch themselves on once their settings are filled in: on the install that has them, or
# on the first update after they were added or pointed somewhere else. A failure here does not fail the install -- Orbit is
# up by now -- but says what to do; the usual one is a replacement server meeting the backups of
# the server it replaces, which it must restore from rather than write over. Its own process, so
# that `set -e` holds inside it.
ensure_backups_on() {
  backup_configured || return 0
  [[ "$(cat "$ORBIT_DATA_DIR/backup-state/initialized" 2>/dev/null)" != "$(backup_config_id)" ]] || return 0
  step "The BACKUP_* settings are new or changed; switching backups on"
  "$DEPLOY_DIR/orbit" backup setup ||
    warn "Backups are NOT on (the reason is above). Once it is fixed: deploy/orbit backup setup"
}

summary() {
  cat <<EOF

$(c_green "Orbit is up") at $ORBIT_PUBLIC_URL (version $ORBIT_VERSION)

Next steps, if you have not done them yet (docs/SELF_HOSTING.md, step 3):
  - DNS: an A record for $ORBIT_DOMAIN pointing at this server's IP address.
  - Google Cloud Console: authorized redirect URI $ORBIT_PUBLIC_URL/auth/v1/callback
EOF
  backup_configured || echo "  - Backups: fill the BACKUP_* lines in deploy/.env and run deploy/orbit update."
  echo "Allowed to sign in: $ORBIT_ALLOWED_EMAILS"
  [[ -n "${ORBIT_MASTER_KEY_CREATED:-}" ]] || return 0
  cat <<EOF

$(c_green "Save the master key now.") Every password and key of this server is derived from it, so
with it and the backup buckets a lost server can be rebuilt. Show it with
  grep ORBIT_MASTER_KEY $ENV_FILE
and keep it in a password manager (or as the ORBIT_MASTER_KEY secret of your GitHub fork).
EOF
}

cmd_status() {
  load_env
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Health}}\t{{.RunningFor}}'
  echo
  echo "URL:     $ORBIT_PUBLIC_URL"
  echo "Version: $ORBIT_VERSION"
  echo "Data:    $ORBIT_DATA_DIR ($(du -sh "$ORBIT_DATA_DIR" 2>/dev/null | cut -f1))"
  backup_status
}

cmd_studio() {
  load_env
  compose --profile studio up -d studio meta api-gw
  cat <<EOF
Supabase Studio is running, reachable only from this machine. From your own computer:

  ssh -L 8000:127.0.0.1:8000 <you>@<this server>

then open http://localhost:8000 and sign in as ${DASHBOARD_USERNAME:-orbit} with DASHBOARD_PASSWORD
from deploy/.env. Stop it with: deploy/orbit studio-stop
EOF
}

usage() {
  cat <<'EOF'
Usage: deploy/orbit <command>

  install          First install on this server (safe to re-run)
  update           Rebuild and migrate after `git pull`
  check            Check the server and deploy/.env without changing anything
  apply-env FILE   Write the NAME=value lines of FILE into deploy/.env (CI and bootstrap.sh use it)
  status           Services, health, URL, data size, last backup
  migrate          Apply database migrations and deploy.sql only
  logs [service]   Follow logs (services: web caddy db auth rest storage realtime functions ...)
  restart [svc]    Restart everything, or one service
  down             Stop everything (data stays in ORBIT_DATA_DIR)
  studio           Start the Supabase dashboard for an SSH-tunnel session
  studio-stop      Stop it again

  backup setup     Check the BACKUP_* settings, create the repositories, take the first backup
  backup now       Take a full backup now (base backup + snapshot)
  backup verify    Restore the latest copies into a scratch directory and check them
  backup status    When each backup job last succeeded
  backup test-alert  Send a test message to the Telegram alerts
  restore [--time "2026-10-17 12:00:00+00"] [--yes]
                   Replace the database (and files) with the latest backup, or the state at --time

  migrate-from-supabase export | receive | import [--yes] | verify
                   Move an Orbit that runs on hosted Supabase onto this server
  compose ...      Run any docker compose command against this stack
  doctor           What this server's network lets Orbit reach, in detail (only reads)
  assemble-functions DIR
                   Write what the edge functions' image is built from into DIR (CI uses it)

Guide: docs/SELF_HOSTING.md
EOF
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    install) cmd_install "$@" ;;
    update) cmd_update "$@" ;;
    check) cmd_check "$@" ;;
    apply-env) cmd_apply_env "$@" ;;
    status) cmd_status "$@" ;;
    build) cmd_build "$@" ;;
    migrate) cmd_migrate "$@" ;;
    logs) load_env && compose logs -f --tail=200 "$@" ;;
    restart) load_env && compose restart "$@" ;;
    down) load_env && compose down ;;
    studio) cmd_studio ;;
    studio-stop) load_env && compose --profile studio stop studio meta ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    migrate-from-supabase) cmd_migrate_from_supabase "$@" ;;
    compose) load_env && compose "$@" ;;
    doctor) bash "$DEPLOY_DIR/doctor.sh" ;;
    assemble-functions) assemble_functions "$@" ;;
    help | -h | --help) usage ;;
    *) usage && exit 1 ;;
  esac
}

main "$@"
