# =================================================================================================
#  Orbit server settings
# =================================================================================================
#
#  How to use this file:
#    1. Copy it:            cp deploy/.env.example deploy/.env
#    2. Open the copy:      nano deploy/.env
#    3. Replace every CHANGE_ME below. Lines marked (optional) can stay empty.
#    4. Save, then run:     deploy/orbit install
#
#  Rules of the format: one setting per line, NAME=value, no spaces around "=", no quotes needed.
#  A line starting with # is a comment and is ignored.
#
#  Passwords, keys and tokens the server needs for itself are NOT here: `deploy/orbit install`
#  creates them and adds them to the bottom of deploy/.env. That makes deploy/.env the most
#  important file on the server -- keep a copy somewhere safe (a password manager is ideal).
#  Never commit it or send it to anyone.
#
#  Step-by-step guide with screenshots-in-words: docs/SELF_HOSTING.md
# =================================================================================================


# -------------------------------------------------------------------------------------------------
#  1. Address
# -------------------------------------------------------------------------------------------------

# The domain people will type into the browser to open Orbit. Only the name: no https://, no
# slash at the end. Before installing, create a DNS "A record" for this name pointing at the IP
# address of this server (where: the website where you bought the domain, section "DNS").
# Example: ORBIT_DOMAIN=orbit.example.com
ORBIT_DOMAIN=CHANGE_ME

# Your e-mail. Let's Encrypt (the free service that issues the HTTPS certificate) writes here only
# if a certificate is about to expire and could not be renewed automatically.
ORBIT_ADMIN_EMAIL=CHANGE_ME

# Who may sign in: Google account e-mails, separated by commas, no spaces.
# Anyone not on this list sees "access denied" even with a valid Google account.
# This list is the whole allowlist: to add or remove someone later, edit it and run
# `deploy/orbit migrate` -- an e-mail taken out of the list loses access.
# Example: ORBIT_ALLOWED_EMAILS=me@gmail.com,partner@gmail.com
ORBIT_ALLOWED_EMAILS=CHANGE_ME


# -------------------------------------------------------------------------------------------------
#  2. Sign in with Google
# -------------------------------------------------------------------------------------------------
#
#  Orbit has no passwords of its own; people sign in with their Google account. For that Google
#  needs to know your Orbit exists. Takes about 5 minutes, free:
#
#    a. Open https://console.cloud.google.com/ and sign in.
#    b. Top bar -> project picker -> "New project" -> any name (e.g. "Orbit") -> Create.
#    c. Menu -> "APIs & Services" -> "OAuth consent screen" -> External -> fill the app name and
#       your e-mail -> Save. On the "Test users" step add the same e-mails as ORBIT_ALLOWED_EMAILS.
#    d. Menu -> "APIs & Services" -> "Credentials" -> "Create credentials" -> "OAuth client ID".
#       Application type: "Web application".
#       "Authorized redirect URIs" -> Add URI -> https://<your ORBIT_DOMAIN>/auth/v1/callback
#       (for example https://orbit.example.com/auth/v1/callback) -> Create.
#    e. Google shows a "Client ID" and a "Client secret". Paste them below.

# Looks like 1234567890-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=CHANGE_ME
# Looks like GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=CHANGE_ME


# -------------------------------------------------------------------------------------------------
#  3. AI features (optional, but most of the health module needs them)
# -------------------------------------------------------------------------------------------------

# (optional) Reading photos of medical documents and sorting bank transactions into categories
# uses AI models through OpenRouter. Create a key at https://openrouter.ai/keys (you pay OpenRouter
# per use; cents per document). Empty = those features are switched off, the rest works.
# Looks like sk-or-v1-xxxxxxxx
OPENROUTER_API_KEY=

# (optional) Which models to use. Empty = the defaults built into Orbit, which is the right
# choice unless you know why you want another one. The values production runs are listed in
# docs/RUNBOOK.md.
OPENROUTER_HEALTH_OCR_MODEL=
OPENROUTER_HEALTH_STRUCTURE_MODEL=
OPENROUTER_HEALTH_STAGE_CLASSIFY_MODEL=
OPENROUTER_HEALTH_STAGE_EXTRACT_MODEL=
OPENROUTER_HEALTH_STAGE_RECONCILE_MODEL=
OPENROUTER_HEALTH_STRUCTURE_FALLBACK_MODELS=
OPENROUTER_MONEY_CATEGORIZE_MODEL=

# (optional) Looking up diagnosis names in the WHO ICD catalogue. Free: register at
# https://icd.who.int/icdapi -> "View API access key(s)". Empty = diagnosis search is off.
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=


# -------------------------------------------------------------------------------------------------
#  4. Advanced (optional) -- leave empty unless you need it
# -------------------------------------------------------------------------------------------------

# Where Orbit keeps its data on this server (database, uploaded files, certificates).
ORBIT_DATA_DIR=/var/lib/orbit

# Docker Hub limits downloads and is blocked in some countries (for example from Russia). If image
# downloads fail with "429 Too Many Requests" or time out, set a mirror, e.g. https://mirror.gcr.io
ORBIT_REGISTRY_MIRROR=

# Let Claude and other AI assistants read your health data through Orbit's MCP connector
# (docs/design/domains/health/mcp-server.md). true or false.
MCP_SERVER_ENABLED=false

# The Chrome extension for importing bank statements, if you publish your own build of it.
NEXT_PUBLIC_EXTENSION_ID=

# Use a prebuilt web image instead of building it on this server (CI does this; see
# docs/SELF_HOSTING.md, "Deploying from GitHub Actions").
ORBIT_WEB_IMAGE=

# Send logs and traces to Grafana Cloud (docs/observability/grafana-cloud.md): off or cloud.
OBS_EXPORTER_MODE=off
OBS_OTLP_ENDPOINT=
OBS_GRAFANA_CLOUD_OTLP_HEADERS=

# For testing on a machine without a real domain only: serve plain HTTP, no certificate.
ORBIT_HTTP_ONLY=false
