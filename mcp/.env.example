# MCP local auth mode for GitHub server:
# - "pat" (default sync behavior): inject Authorization header from MCP_GITHUB_PAT_TOKEN.
# - "oauth" (preferred when available): generate URL-only server config and complete OAuth in the client.
MCP_GITHUB_AUTH_MODE=pat
MCP_GITHUB_PAT_TOKEN=

# Optional Telegram notifications for agent step completion (Codex + Cursor):
# - Set AGENT_TELEGRAM_NOTIFICATIONS_ENABLED=1 to enable notifications.
# - Keep token and chat id only in mcp/.env (local, gitignored).
# - AGENT_TELEGRAM_API_BASE_URL defaults to https://api.telegram.org.
AGENT_TELEGRAM_NOTIFICATIONS_ENABLED=0
AGENT_TELEGRAM_BOT_TOKEN=
AGENT_TELEGRAM_CHAT_ID=
AGENT_TELEGRAM_API_BASE_URL=https://api.telegram.org

# Optional Vercel MCP auth mode:
# - oauth (default sync behavior): URL-only config; complete auth flow in the MCP client.
# - pat: inject Authorization header from VERCEL_ACCESS_TOKEN.
MCP_VERCEL_AUTH_MODE=oauth
VERCEL_ACCESS_TOKEN=

# shadcn MCP server is always included from canonical config and runs:
# npx shadcn@latest mcp

# Optional local Grafana MCP server generation:
# - Set MCP_GRAFANA_LOCAL_ENABLED=1 to include "grafana-local" in generated configs.
MCP_GRAFANA_LOCAL_ENABLED=1
GRAFANA_LOCAL_URL=http://host.docker.internal:3300
GRAFANA_LOCAL_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LOCAL_ORG_ID=1

# Optional local Tempo MCP server generation:
# - Set MCP_TEMPO_LOCAL_ENABLED=1 to include "tempo-local" in generated configs.
# - Tempo MCP endpoint is served by Tempo query-frontend.
MCP_TEMPO_LOCAL_ENABLED=1

# Optional local Supabase MCP server generation:
# - Set MCP_SUPABASE_LOCAL_ENABLED=1 to include "supabase-local" in generated configs.
# - Supabase MCP endpoint is served by the local Supabase stack.
MCP_SUPABASE_LOCAL_ENABLED=1

# Optional Supabase Cloud MCP server generation:
# - Set MCP_SUPABASE_CLOUD_ENABLED=1 to include "supabase-cloud" in generated configs.
# - Auth mode:
#   - oauth (default): URL-only config; complete auth flow in MCP client.
#   - pat: inject Authorization header from SUPABASE_CLOUD_ACCESS_TOKEN.
MCP_SUPABASE_CLOUD_ENABLED=0
MCP_SUPABASE_CLOUD_AUTH_MODE=oauth
SUPABASE_CLOUD_ACCESS_TOKEN=

# Optional Grafana Cloud MCP server generation:
# - Set MCP_GRAFANA_CLOUD_ENABLED=1 to include "grafana-cloud" in generated configs.
# - Requires `mcp-grafana` binary available on PATH; no Docker required.
# - Optional override for GUI clients that do not inherit PATH (for example Windows):
#   MCP_GRAFANA_CLOUD_COMMAND=C:\Users\<you>\bin\mcp-grafana.exe
MCP_GRAFANA_CLOUD_ENABLED=0
MCP_GRAFANA_CLOUD_COMMAND=
GRAFANA_CLOUD_URL=https://<your-stack>.grafana.net
GRAFANA_CLOUD_SERVICE_ACCOUNT_TOKEN=
GRAFANA_CLOUD_ORG_ID=

# Optional Grafana Cloud Tempo MCP server generation:
# - Set MCP_TEMPO_CLOUD_ENABLED=1 to include "tempo-cloud" in generated configs.
# - Endpoint pattern from Grafana Cloud docs: https://<stack>.grafana.net/tempo/api/mcp
# - Authorization header format: Basic <base64(instance_id:token)>
MCP_TEMPO_CLOUD_ENABLED=0
GRAFANA_CLOUD_TEMPO_MCP_URL=https://<your-stack>.grafana.net/tempo/api/mcp
GRAFANA_CLOUD_TEMPO_AUTHORIZATION=

# Optional defaults for scripts/mcp/create-grafana-mcp-token.ts:
# - Local Grafana only.
# - Defaults to basic auth `admin/admin` if no auth vars are set.
GRAFANA_LOCAL_BOOTSTRAP_TOKEN=
GRAFANA_LOCAL_SERVICE_ACCOUNT_ID=
GRAFANA_LOCAL_SERVICE_ACCOUNT_NAME=mcp-local
GRAFANA_LOCAL_SERVICE_ACCOUNT_ROLE=Viewer
GRAFANA_LOCAL_API_AUTH_MODE=basic
GRAFANA_LOCAL_ADMIN_USER=admin
GRAFANA_LOCAL_ADMIN_PASSWORD=admin
