# MCP local auth mode for GitHub server:
# - "pat" (default sync behavior): inject Authorization header from MCP_GITHUB_PAT_TOKEN.
# - "oauth" (preferred when available): generate URL-only server config and complete OAuth in the client.
MCP_GITHUB_AUTH_MODE=pat
MCP_GITHUB_PAT_TOKEN=

# Optional local Grafana MCP server generation:
# - Set MCP_GRAFANA_LOCAL_ENABLED=1 to include "grafana-local" in generated configs.
MCP_GRAFANA_LOCAL_ENABLED=1
GRAFANA_LOCAL_URL=http://host.docker.internal:3300
GRAFANA_LOCAL_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LOCAL_ORG_ID=1

# Optional local Tempo MCP server generation:
# - Set MCP_TEMPO_LOCAL_ENABLED=1 to include "tempo-local" in generated configs.
# - Tempo MCP endpoint is served by Tempo query-frontend.
MCP_TEMPO_LOCAL_ENABLED=1

# Optional Grafana Cloud MCP server generation:
# - Set MCP_GRAFANA_CLOUD_ENABLED=1 to include "grafana-cloud" in generated configs.
MCP_GRAFANA_CLOUD_ENABLED=0
GRAFANA_CLOUD_URL=https://<your-stack>.grafana.net
GRAFANA_CLOUD_SERVICE_ACCOUNT_TOKEN=
GRAFANA_CLOUD_ORG_ID=

# Optional defaults for scripts/mcp/create-grafana-mcp-token.ts:
# - Local Grafana only.
# - Defaults to basic auth `admin/admin` if no auth vars are set.
GRAFANA_LOCAL_BOOTSTRAP_TOKEN=
GRAFANA_LOCAL_SERVICE_ACCOUNT_ID=
GRAFANA_LOCAL_SERVICE_ACCOUNT_NAME=mcp-local
GRAFANA_LOCAL_SERVICE_ACCOUNT_ROLE=Viewer
GRAFANA_LOCAL_API_AUTH_MODE=basic
GRAFANA_LOCAL_ADMIN_USER=admin
GRAFANA_LOCAL_ADMIN_PASSWORD=admin
