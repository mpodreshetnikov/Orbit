{
  "servers": {
    "supabase-cloud": {
      "transport": "http",
      "enabled_env": "MCP_SUPABASE_CLOUD_ENABLED",
      "url": "https://mcp.supabase.com/mcp",
      "auth_kind": "bearer",
      "auth_mode_env": "MCP_SUPABASE_CLOUD_AUTH_MODE",
      "default_auth_mode": "oauth",
      "token_env": "SUPABASE_CLOUD_ACCESS_TOKEN",
      "oauth_supported": true
    },
    "supabase-local": {
      "transport": "http",
      "enabled_env": "MCP_SUPABASE_LOCAL_ENABLED",
      "url": "http://127.0.0.1:54321/mcp"
    },
    "tempo-local": {
      "transport": "http",
      "enabled_env": "MCP_TEMPO_LOCAL_ENABLED",
      "url": "http://localhost:3200/api/mcp"
    },
    "tempo-cloud": {
      "transport": "http",
      "enabled_env": "MCP_TEMPO_CLOUD_ENABLED",
      "url_env": "GRAFANA_CLOUD_TEMPO_MCP_URL",
      "http_headers_env_map": {
        "Authorization": "GRAFANA_CLOUD_TEMPO_AUTHORIZATION"
      }
    },
    "grafana-local": {
      "transport": "stdio",
      "enabled_env": "MCP_GRAFANA_LOCAL_ENABLED",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "-e",
        "GRAFANA_ORG_ID",
        "grafana/mcp-grafana",
        "-t",
        "stdio"
      ],
      "env_map": {
        "GRAFANA_URL": "GRAFANA_LOCAL_URL",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "GRAFANA_LOCAL_SERVICE_ACCOUNT_TOKEN"
      },
      "optional_env_map": {
        "GRAFANA_ORG_ID": "GRAFANA_LOCAL_ORG_ID"
      }
    },
    "grafana-cloud": {
      "transport": "stdio",
      "enabled_env": "MCP_GRAFANA_CLOUD_ENABLED",
      "command": "mcp-grafana",
      "command_env": "MCP_GRAFANA_CLOUD_COMMAND",
      "env_map": {
        "GRAFANA_URL": "GRAFANA_CLOUD_URL",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "GRAFANA_CLOUD_SERVICE_ACCOUNT_TOKEN"
      },
      "optional_env_map": {
        "GRAFANA_ORG_ID": "GRAFANA_CLOUD_ORG_ID"
      }
    },
    "github": {
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "auth_kind": "bearer",
      "auth_mode_env": "MCP_GITHUB_AUTH_MODE",
      "default_auth_mode": "pat",
      "token_env": "MCP_GITHUB_PAT_TOKEN",
      "oauth_supported": true
    }
  }
}
