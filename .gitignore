!.env.observability.example
browserExtension/env.js

# MCP generated local configs and env
/.mcp.json
/.cursor/mcp.json
/.codex/config.toml
mcp/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private task registry. Tasks, decision records and ExecPlans describe unreleased work and live
# in their own private repository (`orbit-tasks`), which its install script links into a local
# checkout at these paths. The links must never be committed here — this repository is public.
/docs/tasks
# PLANS.md moved into docs/tasks/ and is no longer linked on its own. The line stays while
# installations made before the move still have a leftover file at the old path: dropping it now
# would turn that remnant into an untracked file of a public repository.
/docs/PLANS.md
/.agents/skills/task-registry
/.claude/skills/task-registry
/.agents/skills/task-status-sync
/.claude/skills/task-status-sync

# Extraction eval corpus. Case directories may hold scans of real medical documents, which
# belong in a private bucket and never in git history — once a blob is in a pack it cannot be
# taken back. So this is default-deny: everything under cases/ is ignored, and only the three
# reviewed text artefacts are allowed back in. An extension allowlist was tried first and got
# this wrong — it missed `IMG_0001.JPG`, the default name from most cameras and scanners.
test/fixtures/extraction/cases/**/*
!test/fixtures/extraction/cases/**/
!test/fixtures/extraction/cases/**/input.md
!test/fixtures/extraction/cases/**/expected.json
!test/fixtures/extraction/cases/**/meta.json
