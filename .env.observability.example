# Local observability lifecycle toggle (1=enabled, 0=disabled).
OBS_AUTO=1

# Shared telemetry identity defaults.
OBS_APP=orbit
OBS_ENV=local
OBS_RELEASE=dev-local
OBS_COMPONENT=unknown

# Exporter mode: local | cloud
OBS_EXPORTER_MODE=local

# Local defaults (grafana/otel-lgtm from docker-compose.observability.yml).
OBS_LOCAL_GRAFANA_URL=http://127.0.0.1:3300
OBS_LOCAL_OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318
OBS_LOCAL_OTLP_GRPC_ENDPOINT=http://127.0.0.1:4317

# Unified OTLP endpoints used by app-side code (switch by OBS_EXPORTER_MODE).
OBS_OTLP_ENDPOINT=http://127.0.0.1:4318
OBS_OTLP_TRACES_ENDPOINT=
OBS_OTLP_LOGS_ENDPOINT=

# Additional OTLP headers (comma-separated key=value pairs).
# Example cloud value:
# OBS_OTLP_HEADERS=Authorization=Basic <base64-instance-id:token>
OBS_OTLP_HEADERS=

# Optional Grafana Cloud-specific hints (documentation/reference only).
OBS_GRAFANA_CLOUD_URL=
OBS_GRAFANA_CLOUD_OTLP_ENDPOINT=
OBS_GRAFANA_CLOUD_OTLP_HEADERS=
