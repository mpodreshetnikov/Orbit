{
  // Extended by path rather than as the bare "expo/tsconfig.base" specifier Expo documents.
  // That form resolves through the package's exports map, which tsc handles and Vite's own
  // tsconfig reader does not: it looks for a directory of that name and fails to load this project
  // at all, which took the whole mobile test lane down. Expo stays the source of truth either way.
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@db": ["../supabase/db/database.types"],
      // The tests here are run by the repository's own vitest at the root, not by a runner inside
      // this app: vitest's dependency tree and Expo's disagree on vite's version, and the tests
      // need no React Native runtime because every module they touch is pure. Pointing the types at
      // the runner that actually executes them is the accurate statement, not a workaround.
      "vitest": ["../node_modules/vitest"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
