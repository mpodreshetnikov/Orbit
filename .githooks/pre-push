#!/usr/bin/env sh
set -eu

echo "[pre-push] Running secrets preflight..."

if ! command -v just >/dev/null 2>&1; then
  echo "[pre-push] 'just' is required but was not found on PATH."
  exit 1
fi

just secrets-preflight

# The same gate CI runs, one step earlier: a branch pushed over the limit has already been opened as
# a pull request by the time CI says so, and re-cutting it then costs the opening review too.
echo "[pre-push] Checking reviewable change size..."
just quality-pr-size
