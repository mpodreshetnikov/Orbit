#!/usr/bin/env sh
set -eu

# Advisory size check for humans; claim + authorship hard-fail for agent/cloud (D9/D13).

if ! command -v node >/dev/null 2>&1; then
  exit 0
fi

node scripts/just/check-pr-size.cjs --advisory || true

# Claim gate: reports for humans; exits 1 for agent/cloud without an in-progress claim (D9).
node scripts/just/task-claim-hook.cjs --git

# Authorship: strip agent trailers is commit-msg; here refuse agent author on the index tip identity.
# commit-msg hook does the message scrub when installed beside this file.
if [ -f scripts/just/human-authorship.cjs ]; then
  :
fi
