{
  "manifest_version": 3,
  "name": "Orbit",
  "version": "0.1.5",
  "key": "",
  "description": "Bridge for Orbit web app (money import and more).",
  "icons": {
    "16": "icons/icon-128.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://www.tbank.ru/*",
    "https://*.tbank.ru/*",
    "https://web.alfabank.ru/*",
    "https://*.alfabank.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-128.png",
      "32": "icons/icon-128.png",
      "48": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Orbit"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
