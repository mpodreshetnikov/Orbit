{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@supabase/supabase-js": ["../../node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["**/*.ts", "_shared/**/*.ts", "_shared/**/*.d.ts", "../db/database.types.ts"],
  "exclude": ["node_modules"]
}
